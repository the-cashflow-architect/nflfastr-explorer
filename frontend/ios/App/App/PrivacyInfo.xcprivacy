<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gridiron is a reference book. There are no accounts, no identifiers and
	     no analytics: it asks the API for public football statistics and shows
	     them. Nothing about the person using it is collected or sent. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- No required-reason APIs. The theme, density setting and cached figures
	     live in the web view's own storage, which WebKit manages; none of the
	     app's native plugins (app, network, splash screen, status bar) touch
	     UserDefaults, file timestamps, disk space or system boot time. An
	     earlier version declared UserDefaults here; that was inaccurate. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
