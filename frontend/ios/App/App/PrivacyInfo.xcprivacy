<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gridiron is a reference book. There are no accounts, no identifiers and
	     no analytics: it asks the API for public football statistics and shows
	     them, and sends nothing about the person using it. The API's host keeps
	     ordinary request logs for at most 30 days to run the service, not linked
	     to anyone; the in-app privacy page says so, and IOS.md explains why that
	     is still "no data collected" under Apple's definition. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- No required-reason APIs. The theme, density setting and cached figures
	     live in the web view's own storage, which WebKit manages; none of the
	     app's native plugins (network, splash screen, status bar) touch
	     UserDefaults, file timestamps, disk space or system boot time. An
	     earlier version declared UserDefaults here; that was inaccurate. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
