# Comma-separated origins allowed to call the API.
# The deployed frontend URL MUST be listed here or the browser blocks every request.
CORS_ORIGINS=https://nflfastr-explorer.onrender.com

# Optional regex for preview deploys, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Where the DuckDB file lives. Persisting it means a restart re-opens the
# existing tables instead of re-downloading every parquet file.
DUCKDB_PATH=data/nflfastr.duckdb

# DuckDB sizes its buffer pool from host RAM and cannot see a container's
# memory limit, so pin it well below the instance size.
DUCKDB_MEMORY_LIMIT=128MB
DUCKDB_THREADS=1

# Hard ceiling on export size, so one request cannot exhaust memory.
EXPORT_MAX_ROWS=100000
EXPORT_CHUNK_ROWS=5000
